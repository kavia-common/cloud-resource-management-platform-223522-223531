# Environment variables for React frontend
# Note: For Create React App, variables must be prefixed with REACT_APP_

# REQUIRED - Supabase configuration (no secrets hardcoded; provide via deployment env)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# OPTIONAL - App/service endpoints
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# OPTIONAL - Environment and build flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=true

# OPTIONAL - Server and proxy configuration (used in some hosting setups)
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false

# OPTIONAL - Logging and healthcheck
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz

# OPTIONAL - Feature flags
# Can be JSON (e.g., {"newDashboard": true, "billing": false})
# or comma-separated list (e.g., newDashboard,billing)
REACT_APP_FEATURE_FLAGS=

# OPTIONAL - Experiments toggle (expects "true" or "false")
REACT_APP_EXPERIMENTS_ENABLED=false
